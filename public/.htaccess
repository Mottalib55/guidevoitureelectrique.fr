RewriteEngine On
RewriteBase /

# Force HTTPS
# Une seule adresse par page : https://guidevoitureelectrique.fr, en un seul saut.
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://guidevoitureelectrique.fr%{REQUEST_URI} [L,R=301]
# /dossier/index.html est la meme page que /dossier/
RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://guidevoitureelectrique.fr/$1 [L,R=301]
# Barre oblique finale : redirection ecrite ici, sinon Apache renvoie vers
# une adresse portant le port (https://guidevoitureelectrique.fr:443/...)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ https://guidevoitureelectrique.fr/$1/ [L,R=301]

# Directory requests: serve index.html inside the directory
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}index.html -f
RewriteRule ^(.*)$ $1index.html [L]

# Custom 404
ErrorDocument 404 /404.html

# ── Security Headers ──
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# ── Caching ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 1 hour"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 month"
  ExpiresByType application/json          "access plus 1 hour"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

# ── GZIP Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml font/woff font/woff2
</IfModule>
